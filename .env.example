# ================================================================
# PostWire Environment Configuration Template
# ================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Engine Selection: "google_adk" or "offline"
POSTWIRE_AI_MODE=google_adk

# Google Gemini / Google Cloud
# Configurable model version (e.g. gemini-3.6-flash, gemini-1.5-pro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional Google Cloud / Vertex AI settings
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Grafana MCP Integration Mode: "mock" (offline/tests) or "live" (real Grafana Cloud)
POSTWIRE_GRAFANA_MODE=live
POSTWIRE_RUN_GRAFANA_INTEGRATION=true

# Real Grafana Cloud instance settings (leave blank in template; fill in local .env)
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_MCP_COMMAND=python -m uv tool run mcp-grafana

# Optional specific datasource UIDs (auto-discovered via MCP if left blank)
# GRAFANA_PROMETHEUS_UID=
# GRAFANA_LOKI_UID=

# PostWire API Server
PORT=8000
HOST=0.0.0.0
