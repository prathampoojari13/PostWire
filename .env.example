# ================================================================
# PostWire Environment Configuration
# ================================================================

# Environment Mode (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Cloud / Gemini AI
# Supported models: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash, etc.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Grafana MCP Integration
# IMPORTANT:
# - "mock": local development and automated tests (deterministic synthetic telemetry)
# - "live": real Grafana MCP server connection for final hackathon demo
GRAFANA_MCP_MODE=mock

# Real Grafana instance settings (required only when GRAFANA_MCP_MODE=live)
GRAFANA_URL=http://localhost:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_MCP_SERVER_COMMAND=npx -y @grafana/mcp-grafana

# PostWire API Server
PORT=8000
HOST=0.0.0.0
