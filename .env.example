# ================================================================
# PostWire Environment Configuration
# ================================================================

# Environment Mode (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Cloud / Gemini AI
# Supported models: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash, etc.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Grafana MCP Integration
# Modes:
# - "mock": local development and automated tests (deterministic synthetic telemetry)
# - "live": real official mcp-grafana server over stdio for hackathon demo
POSTWIRE_GRAFANA_MODE=mock

# Real Grafana instance settings (required when POSTWIRE_GRAFANA_MODE=live)
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_service_account_token_here
GRAFANA_MCP_COMMAND=mcp-grafana

# Set to true only when running live integration tests against an active Grafana Cloud instance
POSTWIRE_RUN_GRAFANA_INTEGRATION=false

# PostWire API Server
PORT=8000
HOST=0.0.0.0
